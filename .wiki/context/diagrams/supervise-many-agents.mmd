flowchart TD
    A["一群并发智能体（A fleet of agents）"] --> B["状态排气：各会话流出摘要、成本与风险（Status exhaust）"]
    B --> C["注意力防火墙：滤掉例行噪音，只浮出相关变化（Attention firewall）"]
    C --> D["仪表盘：在跑、卡住、完成、昂贵、待审一眼可见（Dashboard）"]
    D --> E{"哪个会话真正需要人？（What needs the human?）"}
    E -- "完成待审" --> F["审查队列：按风险与置信度排序（Review queue）"]
    E -- "异常漂移或失控" --> G["背景审计与成本监控捕获（Auditor + cost monitor）"]
    G -. "失控循环按经济信号报警" .-> H["中断策略：何时允许打扰人（Interrupt policy）"]
    F --> I["人裁决：放行、修正或追责（Human verdict）"]
    H --> I
    I -. "复活旧会话，按先前状态问责" .-> A
    classDef core fill:#1a5fd0,stroke:#12449e,color:#ffffff;
    classDef gate fill:#fdf0ef,stroke:#e0b4b4,color:#8a3a34;
    classDef out fill:#edf1f7,stroke:#c9d6e6,color:#182430;
    class B,C,D,F,G,H core;
    class E gate;
    class A,I out;
